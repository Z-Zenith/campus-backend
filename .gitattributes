# db/init/*.sh is bind-mounted straight into the postgres container (see
# campus-platform's docker-compose.yml) and run there via its #!/bin/sh
# shebang — a CRLF line ending on that first line breaks the interpreter
# lookup on Linux. Force LF on checkout regardless of a contributor's
# core.autocrlf setting.
db/init/*.sh text eol=lf
# Shell scripts run inside Linux containers (Postgres docker-entrypoint-initdb.d) — a
# CRLF checkout (e.g. Windows with core.autocrlf=true) corrupts `set -e` and other
# lines enough that the script silently no-ops instead of erroring loudly, so this
# must stay LF regardless of the checkout platform.
*.sh text eol=lf
